# Copy to backend/.local/secrets/database-operations.env and set mode 0600.
# This file must never be loaded by the API runtime.
DATABASE_BACKUP_URL=postgresql://database_backup:change-me@127.0.0.1:5432/cablix_erp
MIGRATION_DATABASE_URL=postgresql://database_migrator:change-me@127.0.0.1:5432/cablix_erp?schema=public
SHADOW_DATABASE_URL=postgresql://database_migrator:change-me@127.0.0.1:5432/cablix_erp_shadow?schema=public
TEST_DATABASE_URL=postgresql://database_test_admin:change-me@127.0.0.1:5432/cablix_erp_test?schema=public
DATABASE_BACKUP_RETENTION=30
# DATABASE_BACKUP_MIRROR_DIR=/Volumes/ExternalBackup/Cablix
# PG_DUMP_BIN=/Library/PostgreSQL/18/bin/pg_dump
# PG_RESTORE_BIN=/Library/PostgreSQL/18/bin/pg_restore
