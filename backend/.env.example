NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://cablix_app:change-me@127.0.0.1:5432/cablix_erp?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
JWT_ISSUER=cablix-api
JWT_AUDIENCE=cablix-app
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
PLATFORM_ADMIN_NAME=Cablix Platform Admin
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Local development only. Production should use /var/lib/cablix/storage paths.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_TEMP_ROOT=./storage-temp
STORAGE_MAX_FILE_SIZE_MB=10
STORAGE_MAX_FILES_PER_REQUEST=5
