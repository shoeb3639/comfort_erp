NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DATABASE_URL=postgresql://cablix_app:change-me@127.0.0.1:5432/cablix_erp?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
JWT_ISSUER=cablix-api
JWT_AUDIENCE=cablix-app
PLATFORM_ADMIN_NAME=Cablix Platform Admin
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-unique-password
