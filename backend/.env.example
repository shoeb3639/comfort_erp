NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cablix_erp?schema=public
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cablix_erp?schema=public
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cablix_erp_shadow?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cablix_erp_test?schema=public
DATABASE_BACKUP_RETENTION=30
# DATABASE_BACKUP_MIRROR_DIR=/Volumes/ExternalBackup/Cablix
# PG_DUMP_BIN=/Library/PostgreSQL/18/bin/pg_dump
# PG_RESTORE_BIN=/Library/PostgreSQL/18/bin/pg_restore
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
JWT_ISSUER=cablix-api
JWT_AUDIENCE=cablix-app
PLATFORM_ADMIN_NAME=Cablix Platform Admin
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-unique-password
