generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  PENDING_SETUP
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE_PERIOD
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
  CUSTOM
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  FAILED
  REFUNDED
  WAIVED
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

enum SetupRecordStatus {
  ACTIVE
  INACTIVE
}

enum CustomerType {
  RETAIL
  CORPORATE
  TRAVEL_AGENT
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum Salutation {
  MR
  MS
}

enum VehicleOwnershipType {
  OWN
  VENDOR
}

enum DriverEngagementType {
  OWN
  VENDOR
}

enum BookingStatus {
  DRAFT
  CONFIRMED
  ASSIGNED
  RUNNING
  COMPLETED
  CLOSED
  CANCELLED
}

enum BookingType {
  PACKAGE
  LOCAL
  AIRPORT_TRANSFER
  RAILWAY_STATION_TRANSFER
  OUTSTATION
}

enum AssignmentSource {
  OWN
  VENDOR
}

enum PricingBasis {
  FIXED
  RATE_PER_KM
}

enum TripType {
  ONE_WAY
  ROUNDTRIP
  MULTI_CITY
}

enum BillingTripType {
  KM_BASED
  PACKAGE_BASED
}

enum CollectionPaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  CHEQUE
}

enum CollectionStatus {
  PENDING
  WITH_MANAGER
  DEPOSITED
  VERIFIED
  DIRECTLY_RECEIVED
  VOID
}

enum InvoiceStatus {
  DRAFT
  GENERATED
  CANCELLED
}

enum GstType {
  NO_GST
  CGST_SGST
  IGST
}

enum AccountTransactionType {
  FUND_RELEASE
  EXPENSE
  ADJUSTMENT
  FUND_RETURN
  DRIVER_ADVANCE
  DRIVER_RECOVERY
  PARTNER_WITHDRAWAL
  OWNER_WITHDRAWAL
  EMPLOYEE_ADVANCE
}

enum AccountPaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  CHEQUE
}

enum AccountEntryDirection {
  CREDIT
  DEBIT
}

enum AccountExpenseCategory {
  FUEL
  VEHICLE_MAINTENANCE
  DRIVER_PAYMENT
  OFFICE_EXPENSE
  EMPLOYEE_ADVANCE
  PARTNER_OWNER_WITHDRAWAL
  RECOVERABLE_TRIP_CHARGE
  OTHER
}

enum AccountReferenceSource {
  COLLECTION
  CASH_DEPOSIT
  FUND_RELEASE
  EXPENSE
  ADJUSTMENT
  FUND_RETURN
}

enum CashDepositStatus {
  COLLECTED
  WITH_MANAGER
  DEPOSITED
  VERIFIED
  MISMATCH
  VOID
}

enum CashDepositMode {
  CASH_DEPOSIT
  UPI
  BANK_TRANSFER
}

enum ManagerLedgerEntryType {
  OPENING_BALANCE
  FUND_RELEASE
  EXPENSE
  ADJUSTMENT
  FUND_RETURN
  DRIVER_ADVANCE
  DRIVER_RECOVERY
  PARTNER_WITHDRAWAL
  OWNER_WITHDRAWAL
  EMPLOYEE_ADVANCE
  REVERSAL
}

enum FundReleaseStatus {
  PENDING
  APPROVED
  VERIFIED
  REJECTED
}

enum DailyClosingStatus {
  OPEN
  CLOSED
}

enum AuditResolutionStatus {
  OPEN
  RESOLVED
}

model PlatformUser {
  id                String     @id @default(uuid()) @db.Uuid
  name              String     @db.VarChar(150)
  email             String     @unique(map: "platform_users_email_key") @db.VarChar(255)
  mobile            String?    @db.VarChar(30)
  designation       String?    @db.VarChar(100)
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  roleId            String     @map("role_id") @db.Uuid
  status            UserStatus @default(PENDING_ACTIVATION)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  role                 PlatformRole           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens        PlatformRefreshToken[]
  auditLogs            PlatformAuditLog[]     @relation("PlatformAuditActor")
  createdTenants       Tenant[]               @relation("TenantCreatedBy")
  updatedTenants       Tenant[]               @relation("TenantUpdatedBy")
  createdPlans         SubscriptionPlan[]     @relation("PlanCreatedBy")
  updatedPlans         SubscriptionPlan[]     @relation("PlanUpdatedBy")
  createdSubscriptions TenantSubscription[]   @relation("SubscriptionCreatedBy")
  updatedSubscriptions TenantSubscription[]   @relation("SubscriptionUpdatedBy")
  recordedPayments     SubscriptionPayment[]  @relation("PaymentRecordedBy")

  @@index([roleId], map: "platform_users_role_id_idx")
  @@index([status], map: "platform_users_status_idx")
  @@map("platform_users")
}

model PlatformRole {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(100)
  code         String     @unique(map: "platform_roles_code_key") @db.VarChar(100)
  description  String?    @db.Text
  isSystemRole Boolean    @default(false) @map("is_system_role")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  users       PlatformUser[]
  permissions PlatformRolePermission[]

  @@index([status], map: "platform_roles_status_idx")
  @@map("platform_roles")
}

model PlatformPermission {
  id            String   @id @default(uuid()) @db.Uuid
  module        String   @db.VarChar(100)
  action        String   @db.VarChar(100)
  permissionKey String   @unique(map: "platform_permissions_key_key") @map("permission_key") @db.VarChar(200)
  description   String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles PlatformRolePermission[]

  @@unique([module, action], map: "platform_permissions_module_action_key")
  @@map("platform_permissions")
}

model PlatformRolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "platform_role_permissions_role_permission_key")
  @@index([permissionId], map: "platform_role_permissions_permission_id_idx")
  @@map("platform_role_permissions")
}

model PlatformRefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  platformUserId String    @map("platform_user_id") @db.Uuid
  tokenHash      String    @unique(map: "platform_refresh_tokens_hash_key") @map("token_hash") @db.VarChar(255)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress      String?   @map("ip_address") @db.VarChar(64)
  userAgent      String?   @map("user_agent") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId, expiresAt], map: "platform_refresh_tokens_user_expiry_idx")
  @@map("platform_refresh_tokens")
}

model Tenant {
  id                        String           @id @default(uuid()) @db.Uuid
  code                      String           @unique(map: "tenants_code_key") @db.VarChar(50)
  legalName                 String           @map("legal_name") @db.VarChar(200)
  tradeName                 String?          @map("trade_name") @db.VarChar(200)
  businessType              String?          @map("business_type") @db.VarChar(100)
  email                     String           @db.VarChar(255)
  mobile                    String           @db.VarChar(30)
  alternateNumber           String?          @map("alternate_number") @db.VarChar(30)
  website                   String?          @db.VarChar(255)
  logoUrl                   String?          @map("logo_url") @db.Text
  addressLine1              String?          @map("address_line_1") @db.VarChar(255)
  addressLine2              String?          @map("address_line_2") @db.VarChar(255)
  city                      String?          @db.VarChar(100)
  state                     String?          @db.VarChar(100)
  pinCode                   String?          @map("pin_code") @db.VarChar(20)
  country                   String           @default("India") @db.VarChar(100)
  gstin                     String?          @db.VarChar(20)
  pan                       String?          @db.VarChar(20)
  companyRegistrationNumber String?          @map("company_registration_number") @db.VarChar(100)
  stateCode                 String?          @map("state_code") @db.VarChar(10)
  taxRegistrationType       String?          @map("tax_registration_type") @db.VarChar(50)
  billingAddress            Json?            @map("billing_address")
  defaultCurrency           String           @default("INR") @map("default_currency") @db.Char(3)
  timeZone                  String           @default("Asia/Kolkata") @map("time_zone") @db.VarChar(100)
  financialYearStartMonth   Int              @default(4) @map("financial_year_start_month")
  dateFormat                String           @default("DD/MM/YYYY") @map("date_format") @db.VarChar(30)
  invoicePrefix             String?          @map("invoice_prefix") @db.VarChar(30)
  invoiceNumberLength       Int              @default(6) @map("invoice_number_length")
  bookingPrefix             String?          @unique(map: "tenants_booking_prefix_key") @map("booking_prefix") @db.Char(4)
  smsPrefix                 String?          @map("sms_prefix") @db.VarChar(12)
  invoiceSettings           Json?            @map("invoice_settings")
  taxSettings               Json?            @map("tax_settings")
  status                    TenantStatus     @default(PENDING_SETUP)
  onboardingStatus          OnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  createdById               String?          @map("created_by") @db.Uuid
  updatedById               String?          @map("updated_by") @db.Uuid
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt                  DateTime?        @map("closed_at") @db.Timestamptz(6)

  createdBy            PlatformUser?             @relation("TenantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            PlatformUser?             @relation("TenantUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  subscriptions        TenantSubscription[]
  users                TenantUser[]
  roles                TenantRole[]
  rolePermissions      TenantRolePermission[]
  refreshTokens        TenantRefreshToken[]
  onboardingItems      TenantOnboardingItem[]
  auditLogs            TenantAuditLog[]
  gstRegistrations     GstRegistration[]
  bankAccounts         TenantBankAccount[]
  locations            TenantLocation[]
  userLocations        TenantUserLocation[]
  gstLocations         GstRegistrationLocation[]
  customers            Customer[]
  customerContacts     CustomerContact[]
  travellers           CustomerTraveller[]
  vendors              Vendor[]
  vehicleTypes         VehicleType[]
  vehicles             Vehicle[]
  drivers              Driver[]
  bookings             Booking[]
  bookingClosures      BookingClosure[]
  bookingCollections   BookingCollection[]
  invoices             Invoice[]
  accountReferences    AccountReference[]
  cashDeposits         BookingCashDeposit[]
  managerLedgers       ManagerLedger[]
  managerLedgerEntries ManagerLedgerEntry[]
  fundReleases         CompanyFundRelease[]
  accountTransactions  AccountTransaction[]
  dailyClosings        DailyClosing[]
  auditResolutions     AccountAuditResolution[]

  @@index([status], map: "tenants_status_idx")
  @@index([onboardingStatus], map: "tenants_onboarding_status_idx")
  @@index([createdAt], map: "tenants_created_at_idx")
  @@map("tenants")
}

model Vendor {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  vendorCode  String            @map("vendor_code") @db.VarChar(50)
  name        String            @db.VarChar(200)
  recordType  String            @map("record_type") @db.VarChar(50)
  category    String            @db.VarChar(100)
  rating      Decimal           @default(0) @db.Decimal(3, 2)
  phone       String            @db.VarChar(30)
  city        String            @db.VarChar(100)
  status      SetupRecordStatus @default(ACTIVE)
  createdById String?           @map("created_by") @db.Uuid
  updatedById String?           @map("updated_by") @db.Uuid
  deletedById String?           @map("deleted_by") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicles Vehicle[]
  drivers  Driver[]
  bookings Booking[]

  @@unique([tenantId, id], map: "vendors_tenant_id_id_key")
  @@unique([tenantId, vendorCode], map: "vendors_tenant_code_key")
  @@index([tenantId, status], map: "vendors_tenant_status_idx")
  @@map("vendors")
}

model VehicleType {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  name      String            @db.VarChar(100)
  status    SetupRecordStatus @default(ACTIVE)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicles Vehicle[]

  @@unique([tenantId, id], map: "vehicle_types_tenant_id_id_key")
  @@unique([tenantId, name], map: "vehicle_types_tenant_name_key")
  @@index([tenantId, status], map: "vehicle_types_tenant_status_idx")
  @@map("vehicle_types")
}

model Vehicle {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  ownershipType      VehicleOwnershipType @map("ownership_type")
  vendorId           String?              @map("vendor_id") @db.Uuid
  vehicleCode        String               @map("vehicle_code") @db.VarChar(50)
  registrationNumber String               @map("registration_number") @db.VarChar(30)
  vehicleTypeId      String               @map("vehicle_type_id") @db.Uuid
  make               String?              @db.VarChar(150)
  model              String?              @db.VarChar(150)
  variant            String?              @db.VarChar(150)
  fuelType           String?              @map("fuel_type") @db.VarChar(50)
  manufacturingYear  Int?                 @map("manufacturing_year") @db.SmallInt
  registrationDate   DateTime?            @map("registration_date") @db.Date
  insuranceExpiry    DateTime?            @map("insurance_expiry") @db.Date
  permitExpiry       DateTime?            @map("permit_expiry") @db.Date
  fitnessExpiry      DateTime?            @map("fitness_expiry") @db.Date
  seatingCapacity    Int?                 @map("seating_capacity")
  status             SetupRecordStatus    @default(ACTIVE)
  createdById        String?              @map("created_by") @db.Uuid
  updatedById        String?              @map("updated_by") @db.Uuid
  deletedById        String?              @map("deleted_by") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?            @map("deleted_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vendor      Vendor?     @relation(fields: [tenantId, vendorId], references: [tenantId, id], onDelete: Restrict)
  vehicleType VehicleType @relation(fields: [tenantId, vehicleTypeId], references: [tenantId, id], onDelete: Restrict)
  bookings    Booking[]

  @@unique([tenantId, id], map: "vehicles_tenant_id_id_key")
  @@unique([tenantId, vehicleCode], map: "vehicles_tenant_code_key")
  @@index([tenantId, ownershipType, status], map: "vehicles_tenant_ownership_status_idx")
  @@index([tenantId, vendorId], map: "vehicles_tenant_vendor_idx")
  @@index([tenantId, vehicleTypeId], map: "vehicles_tenant_type_idx")
  @@map("vehicles")
}

model Driver {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  engagementType  DriverEngagementType @map("engagement_type")
  vendorId        String?              @map("vendor_id") @db.Uuid
  driverCode      String               @map("driver_code") @db.VarChar(50)
  salutation      Salutation?
  name            String               @db.VarChar(150)
  mobile          String               @db.VarChar(30)
  alternateMobile String?              @map("alternate_mobile") @db.VarChar(30)
  licenceNumber   String?              @map("licence_number") @db.VarChar(100)
  licenceType     String?              @map("licence_type") @db.VarChar(100)
  licenceExpiry   DateTime?            @map("licence_expiry") @db.Date
  address         String?              @db.Text
  identityDetails Json?                @map("identity_details")
  status          SetupRecordStatus    @default(ACTIVE)
  createdById     String?              @map("created_by") @db.Uuid
  updatedById     String?              @map("updated_by") @db.Uuid
  deletedById     String?              @map("deleted_by") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?            @map("deleted_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vendor   Vendor?   @relation(fields: [tenantId, vendorId], references: [tenantId, id], onDelete: Restrict)
  bookings Booking[]

  @@unique([tenantId, id], map: "drivers_tenant_id_id_key")
  @@unique([tenantId, driverCode], map: "drivers_tenant_code_key")
  @@index([tenantId, engagementType, status], map: "drivers_tenant_engagement_status_idx")
  @@index([tenantId, vendorId], map: "drivers_tenant_vendor_idx")
  @@map("drivers")
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  customerCode   String         @map("customer_code") @db.VarChar(50)
  type           CustomerType
  salutation     Salutation?
  name           String         @db.VarChar(200)
  billingName    String         @map("billing_name") @db.VarChar(200)
  email          String?        @db.VarChar(255)
  phone          String         @db.VarChar(30)
  city           String?        @db.VarChar(100)
  gstin          String?        @db.VarChar(20)
  billingAddress String?        @map("billing_address") @db.Text
  creditLimit    Decimal        @default(0) @map("credit_limit") @db.Decimal(14, 2)
  outstanding    Decimal        @default(0) @db.Decimal(14, 2)
  status         CustomerStatus @default(ACTIVE)
  createdById    String?        @map("created_by") @db.Uuid
  updatedById    String?        @map("updated_by") @db.Uuid
  deletedById    String?        @map("deleted_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(6)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contacts   CustomerContact[]
  travellers CustomerTraveller[]
  bookings   Booking[]
  invoices   Invoice[]

  @@unique([tenantId, id], map: "customers_tenant_id_id_key")
  @@unique([tenantId, customerCode], map: "customers_tenant_code_key")
  @@index([tenantId, status], map: "customers_tenant_status_idx")
  @@index([tenantId, name], map: "customers_tenant_name_idx")
  @@map("customers")
}

model CustomerContact {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  customerId String      @map("customer_id") @db.Uuid
  salutation Salutation?
  name       String      @db.VarChar(150)
  role       String?     @db.VarChar(100)
  phone      String?     @db.VarChar(30)
  email      String?     @db.VarChar(255)
  isPrimary  Boolean     @default(false) @map("is_primary")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, customerId], map: "customer_contacts_tenant_customer_idx")
  @@map("customer_contacts")
}

model CustomerTraveller {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  customerId    String         @map("customer_id") @db.Uuid
  travellerType String         @map("traveller_type") @db.VarChar(50)
  salutation    Salutation?
  name          String         @db.VarChar(150)
  phone         String?        @db.VarChar(30)
  email         String?        @db.VarChar(255)
  department    String?        @db.VarChar(100)
  employeeId    String?        @map("employee_id") @db.VarChar(100)
  notes         String?        @db.Text
  status        CustomerStatus @default(ACTIVE)
  createdById   String?        @map("created_by") @db.Uuid
  updatedById   String?        @map("updated_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  bookings Booking[]

  @@unique([tenantId, id], map: "customer_travellers_tenant_id_id_key")
  @@index([tenantId, customerId, status], map: "customer_travellers_tenant_customer_status_idx")
  @@map("customer_travellers")
}

model Booking {
  id                     String           @id @default(uuid()) @db.Uuid
  tenantId               String           @map("tenant_id") @db.Uuid
  bookingNumber          String           @unique(map: "bookings_booking_id_key") @map("booking_id") @db.VarChar(11)
  customerId             String           @map("customer_id") @db.Uuid
  travellerId            String?          @map("traveller_id") @db.Uuid
  bookingType            BookingType      @map("booking_type")
  bookingPackage         String?          @map("booking_package") @db.VarChar(100)
  tripType               TripType         @default(ONE_WAY) @map("trip_type")
  serviceCity            String           @map("service_city") @db.VarChar(100)
  startDate              DateTime         @map("start_date") @db.Date
  endDate                DateTime         @map("end_date") @db.Date
  pickupTime             String           @map("pickup_time") @db.VarChar(5)
  travellingFrom         String?          @map("travelling_from") @db.VarChar(500)
  travellingTo           String?          @map("travelling_to") @db.VarChar(500)
  pickupReportingAddress String           @map("pickup_reporting_address") @db.VarChar(500)
