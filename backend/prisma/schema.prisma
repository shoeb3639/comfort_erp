generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  PENDING_SETUP
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE_PERIOD
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
  CUSTOM
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  FAILED
  REFUNDED
  WAIVED
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

model PlatformUser {
  id                String     @id @default(uuid()) @db.Uuid
  name              String     @db.VarChar(150)
  email             String     @unique(map: "platform_users_email_key") @db.VarChar(255)
  mobile            String?    @db.VarChar(30)
  designation       String?    @db.VarChar(100)
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  roleId            String     @map("role_id") @db.Uuid
  status            UserStatus @default(PENDING_ACTIVATION)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  role                 PlatformRole           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens        PlatformRefreshToken[]
  auditLogs            PlatformAuditLog[]     @relation("PlatformAuditActor")
  createdTenants       Tenant[]               @relation("TenantCreatedBy")
  updatedTenants       Tenant[]               @relation("TenantUpdatedBy")
  createdPlans         SubscriptionPlan[]     @relation("PlanCreatedBy")
  updatedPlans         SubscriptionPlan[]     @relation("PlanUpdatedBy")
  createdSubscriptions TenantSubscription[]   @relation("SubscriptionCreatedBy")
  updatedSubscriptions TenantSubscription[]   @relation("SubscriptionUpdatedBy")
  recordedPayments     SubscriptionPayment[]  @relation("PaymentRecordedBy")

  @@index([roleId], map: "platform_users_role_id_idx")
  @@index([status], map: "platform_users_status_idx")
  @@map("platform_users")
}

model PlatformRole {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(100)
  code         String     @unique(map: "platform_roles_code_key") @db.VarChar(100)
  description  String?    @db.Text
  isSystemRole Boolean    @default(false) @map("is_system_role")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  users       PlatformUser[]
  permissions PlatformRolePermission[]

  @@index([status], map: "platform_roles_status_idx")
  @@map("platform_roles")
}

model PlatformPermission {
  id            String   @id @default(uuid()) @db.Uuid
  module        String   @db.VarChar(100)
  action        String   @db.VarChar(100)
  permissionKey String   @unique(map: "platform_permissions_key_key") @map("permission_key") @db.VarChar(200)
  description   String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles PlatformRolePermission[]

  @@unique([module, action], map: "platform_permissions_module_action_key")
  @@map("platform_permissions")
}

model PlatformRolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "platform_role_permissions_role_permission_key")
  @@index([permissionId], map: "platform_role_permissions_permission_id_idx")
  @@map("platform_role_permissions")
}

model PlatformRefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  platformUserId String    @map("platform_user_id") @db.Uuid
  tokenHash      String    @unique(map: "platform_refresh_tokens_hash_key") @map("token_hash") @db.VarChar(255)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress      String?   @map("ip_address") @db.VarChar(64)
  userAgent      String?   @map("user_agent") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId, expiresAt], map: "platform_refresh_tokens_user_expiry_idx")
  @@map("platform_refresh_tokens")
}

model Tenant {
  id                        String           @id @default(uuid()) @db.Uuid
  code                      String           @unique(map: "tenants_code_key") @db.VarChar(50)
  legalName                 String           @map("legal_name") @db.VarChar(200)
  tradeName                 String?          @map("trade_name") @db.VarChar(200)
  businessType              String?          @map("business_type") @db.VarChar(100)
  email                     String           @db.VarChar(255)
  mobile                    String           @db.VarChar(30)
  alternateNumber           String?          @map("alternate_number") @db.VarChar(30)
  website                   String?          @db.VarChar(255)
  logoUrl                   String?          @map("logo_url") @db.Text
  addressLine1              String?          @map("address_line_1") @db.VarChar(255)
  addressLine2              String?          @map("address_line_2") @db.VarChar(255)
  city                      String?          @db.VarChar(100)
  state                     String?          @db.VarChar(100)
  pinCode                   String?          @map("pin_code") @db.VarChar(20)
  country                   String           @default("India") @db.VarChar(100)
  gstin                     String?          @db.VarChar(20)
  pan                       String?          @db.VarChar(20)
  companyRegistrationNumber String?          @map("company_registration_number") @db.VarChar(100)
  stateCode                 String?          @map("state_code") @db.VarChar(10)
  taxRegistrationType       String?          @map("tax_registration_type") @db.VarChar(50)
  billingAddress            Json?            @map("billing_address")
  defaultCurrency           String           @default("INR") @map("default_currency") @db.Char(3)
  timeZone                  String           @default("Asia/Kolkata") @map("time_zone") @db.VarChar(100)
  financialYearStartMonth   Int              @default(4) @map("financial_year_start_month")
  dateFormat                String           @default("DD/MM/YYYY") @map("date_format") @db.VarChar(30)
  invoicePrefix             String?          @map("invoice_prefix") @db.VarChar(30)
  invoiceNumberLength       Int              @default(6) @map("invoice_number_length")
  taxSettings               Json?            @map("tax_settings")
  status                    TenantStatus     @default(PENDING_SETUP)
  onboardingStatus          OnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  createdById               String?          @map("created_by") @db.Uuid
  updatedById               String?          @map("updated_by") @db.Uuid
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt                  DateTime?        @map("closed_at") @db.Timestamptz(6)

  createdBy       PlatformUser?          @relation("TenantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       PlatformUser?          @relation("TenantUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  subscriptions   TenantSubscription[]
  users           TenantUser[]
  roles           TenantRole[]
  rolePermissions TenantRolePermission[]
  refreshTokens   TenantRefreshToken[]
  onboardingItems TenantOnboardingItem[]
  auditLogs       TenantAuditLog[]

  @@index([status], map: "tenants_status_idx")
  @@index([onboardingStatus], map: "tenants_onboarding_status_idx")
  @@index([createdAt], map: "tenants_created_at_idx")
  @@map("tenants")
}

model SubscriptionPlan {
  id             String       @id @default(uuid()) @db.Uuid
  code           String       @unique(map: "subscription_plans_code_key") @db.VarChar(50)
  name           String       @db.VarChar(150)
  description    String?      @db.Text
  billingCycle   BillingCycle @map("billing_cycle")
  basePrice      Decimal      @map("base_price") @db.Decimal(12, 2)
  validityDays   Int?         @map("validity_days")
  userLimit      Int?         @map("user_limit")
  vehicleLimit   Int?         @map("vehicle_limit")
  bookingLimit   Int?         @map("booking_limit")
  storageLimitMb Int?         @map("storage_limit_mb")
  trialDays      Int          @default(0) @map("trial_days")
  isActive       Boolean      @default(true) @map("is_active")
  createdById    String?      @map("created_by") @db.Uuid
  updatedById    String?      @map("updated_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy     PlatformUser?        @relation("PlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     PlatformUser?        @relation("PlanUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  subscriptions TenantSubscription[]

  @@index([isActive], map: "subscription_plans_active_idx")
  @@map("subscription_plans")
}

model TenantSubscription {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  planId         String             @map("plan_id") @db.Uuid
  status         SubscriptionStatus
  billingCycle   BillingCycle       @map("billing_cycle")
  startsAt       DateTime           @map("starts_at") @db.Timestamptz(6)
  expiresAt      DateTime           @map("expires_at") @db.Timestamptz(6)
  trialEndsAt    DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  graceEndsAt    DateTime?          @map("grace_ends_at") @db.Timestamptz(6)
  userLimit      Int?               @map("user_limit")
  vehicleLimit   Int?               @map("vehicle_limit")
  bookingLimit   Int?               @map("booking_limit")
  storageLimitMb Int?               @map("storage_limit_mb")
  currency       String             @default("INR") @db.Char(3)
  amount         Decimal            @db.Decimal(12, 2)
  discountAmount Decimal            @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal            @default(0) @map("tax_amount") @db.Decimal(12, 2)
  finalAmount    Decimal            @map("final_amount") @db.Decimal(12, 2)
  paymentStatus  PaymentStatus      @default(PENDING) @map("payment_status")
  createdById    String?            @map("created_by") @db.Uuid
  updatedById    String?            @map("updated_by") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan      SubscriptionPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy PlatformUser?         @relation("SubscriptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy PlatformUser?         @relation("SubscriptionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  payments  SubscriptionPayment[]

  @@index([tenantId, status], map: "tenant_subscriptions_tenant_status_idx")
  @@index([tenantId, expiresAt], map: "tenant_subscriptions_tenant_expiry_idx")
  @@index([planId], map: "tenant_subscriptions_plan_id_idx")
  @@map("tenant_subscriptions")
}

model SubscriptionPayment {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantSubscriptionId String        @map("tenant_subscription_id") @db.Uuid
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("INR") @db.Char(3)
  status               PaymentStatus @default(PENDING)
  paymentMethod        String?       @map("payment_method") @db.VarChar(50)
  paymentReference     String?       @unique(map: "subscription_payments_reference_key") @map("payment_reference") @db.VarChar(150)
  paidAt               DateTime?     @map("paid_at") @db.Timestamptz(6)
  remarks              String?       @db.Text
  recordedById         String?       @map("recorded_by") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenantSubscription TenantSubscription @relation(fields: [tenantSubscriptionId], references: [id], onDelete: Restrict)
  recordedBy         PlatformUser?      @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([tenantSubscriptionId, createdAt], map: "subscription_payments_subscription_created_idx")
  @@index([status], map: "subscription_payments_status_idx")
  @@map("subscription_payments")
}

model TenantRole {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  name         String     @db.VarChar(100)
  code         String     @db.VarChar(100)
  description  String?    @db.Text
  isSystemRole Boolean    @default(false) @map("is_system_role")
  status       UserStatus @default(ACTIVE)
  createdById  String?    @map("created_by") @db.Uuid
  updatedById  String?    @map("updated_by") @db.Uuid
  deletedById  String?    @map("deleted_by") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  users       TenantUser[]
  permissions TenantRolePermission[]

  @@unique([tenantId, id], map: "tenant_roles_tenant_id_id_key")
  @@unique([tenantId, code], map: "tenant_roles_tenant_code_key")
  @@index([tenantId, status], map: "tenant_roles_tenant_status_idx")
  @@map("tenant_roles")
}

model Permission {
  id            String   @id @default(uuid()) @db.Uuid
  module        String   @db.VarChar(100)
  action        String   @db.VarChar(100)
  permissionKey String   @unique(map: "permissions_key_key") @map("permission_key") @db.VarChar(200)
  description   String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles TenantRolePermission[]

  @@unique([module, action], map: "permissions_module_action_key")
  @@map("permissions")
}

model TenantRolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdById  String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role       TenantRole @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId, permissionId], map: "tenant_role_permissions_tenant_role_permission_key")
  @@index([tenantId, permissionId], map: "tenant_role_permissions_tenant_permission_idx")
  @@map("tenant_role_permissions")
}

model TenantUser {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  roleId            String     @map("role_id") @db.Uuid
  name              String     @db.VarChar(150)
  email             String     @db.VarChar(255)
  mobile            String?    @db.VarChar(30)
  designation       String?    @db.VarChar(100)
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  isPrimaryOwner    Boolean    @default(false) @map("is_primary_owner")
  status            UserStatus @default(PENDING_ACTIVATION)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  createdById       String?    @map("created_by") @db.Uuid
  updatedById       String?    @map("updated_by") @db.Uuid
  deletedById       String?    @map("deleted_by") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role           TenantRole             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  refreshTokens  TenantRefreshToken[]
  completedItems TenantOnboardingItem[] @relation("OnboardingCompletedBy")
  auditLogs      TenantAuditLog[]       @relation("TenantAuditActor")

  @@unique([tenantId, id], map: "tenant_users_tenant_id_id_key")
  @@unique([tenantId, email], map: "tenant_users_tenant_email_key")
  @@index([tenantId, status], map: "tenant_users_tenant_status_idx")
  @@index([tenantId, roleId], map: "tenant_users_tenant_role_idx")
  @@index([tenantId, isPrimaryOwner], map: "tenant_users_tenant_primary_owner_idx")
  @@map("users")
}

model TenantRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "tenant_refresh_tokens_hash_key") @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  userAgent String?   @map("user_agent") @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   TenantUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, userId, expiresAt], map: "tenant_refresh_tokens_tenant_user_expiry_idx")
  @@map("refresh_tokens")
}

model TenantOnboardingItem {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  code          String    @db.VarChar(100)
  label         String    @db.VarChar(200)
  isCompleted   Boolean   @default(false) @map("is_completed")
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  completedById String?   @map("completed_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  completedBy TenantUser? @relation("OnboardingCompletedBy", fields: [tenantId, completedById], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, code], map: "tenant_onboarding_items_tenant_code_key")
  @@index([tenantId, isCompleted], map: "tenant_onboarding_items_tenant_completed_idx")
  @@map("tenant_onboarding_items")
}

model PlatformAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  module      String   @db.VarChar(100)
  referenceId String?  @map("reference_id") @db.VarChar(100)
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  remarks     String?  @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor PlatformUser? @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([module, referenceId], map: "platform_audit_logs_module_reference_idx")
  @@index([actorUserId, createdAt], map: "platform_audit_logs_actor_created_idx")
  @@index([createdAt], map: "platform_audit_logs_created_at_idx")
  @@map("platform_audit_logs")
}

model TenantAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  module      String   @db.VarChar(100)
  referenceId String?  @map("reference_id") @db.VarChar(100)
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  remarks     String?  @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  TenantUser? @relation("TenantAuditActor", fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, module, referenceId], map: "tenant_audit_logs_tenant_module_reference_idx")
  @@index([tenantId, actorUserId, createdAt], map: "tenant_audit_logs_tenant_actor_created_idx")
  @@index([tenantId, createdAt], map: "tenant_audit_logs_tenant_created_at_idx")
  @@map("tenant_audit_logs")
}
