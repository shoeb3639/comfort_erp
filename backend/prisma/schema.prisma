  @@index([createdAt], map: "platform_audit_logs_created_at_idx")
  @@map("platform_audit_logs")
}

model TenantAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  module      String   @db.VarChar(100)
  referenceId String?  @map("reference_id") @db.VarChar(100)
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  remarks     String?  @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  TenantUser? @relation("TenantAuditActor", fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, module, referenceId], map: "tenant_audit_logs_tenant_module_reference_idx")
  @@index([tenantId, actorUserId, createdAt], map: "tenant_audit_logs_tenant_actor_created_idx")
  @@index([tenantId, createdAt], map: "tenant_audit_logs_tenant_created_at_idx")
  @@map("tenant_audit_logs")
}
